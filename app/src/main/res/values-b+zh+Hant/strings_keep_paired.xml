<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="keep_paired_title">要永久保持配對嗎？</string>
    <string name="keep_paired_body">如果 7 天沒有 USB 連線，Android 會忘記配對，之後在你重新配對前，通話都不會被錄音。CallVault 可以關閉這個時間限制。</string>
    <string name="keep_paired_note">這也會讓你曾允許 USB 偵錯的電腦保持允許狀態。你可以在 設定 ▸ 連線 ▸ 永久保持配對 中再次關閉。</string>
    <string name="keep_paired_accept">保持配對</string>
    <string name="keep_paired_decline">保留限制</string>
    <string name="keep_paired_setting_label">永久保持配對</string>
    <string name="keep_paired_setting_description">防止 Android 在 7 天沒有 USB 連線後忘記配對。</string>
    <string name="keep_paired_setting_failed">無法變更限制。配對仍可能過期。</string>
    <string name="keep_paired_setting_external">其他程式已關閉此限制，因此 CallVault 不會更動它。</string>
    <string name="keep_paired_restore_title">要重新開啟 7 天限制嗎？</string>
    <string name="keep_paired_restore_text">如果 CallVault 是在 7 天多以前透過 Wi-Fi 配對的，Android 可能會立刻忘記配對，在你重新配對前，通話都不會被錄音。</string>
    <string name="keep_paired_restore_confirm">開啟</string>
    <string name="keep_paired_restore_cancel">取消</string>
    <string name="keep_paired_setting_changed">限制已在其他地方被變更，因此 CallVault 保持原狀。</string>
</resources>
